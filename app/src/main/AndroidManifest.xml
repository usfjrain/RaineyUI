<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <queries>
        <package android:name="com.explusalpha.NesEmu" />
        <package android:name="com.explusalpha.Snes9xPlus" />
        <package android:name="com.explusalpha.MdEmu" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="com.flycast.emulator" />
        <package android:name="org.flycast.emulator" />
        <package android:name="io.recompiled.redream" />
        <package android:name="paulscode.android.mupen64plus" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="com.joyemu.fbaapp" />
        <package android:name="me.magnum.melonds" />
        <package android:name="com.dsemu.drastic" />
        <package android:name="com.swordfish.lemuroid" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.mmjr" />
        <package android:name="org.citra.emu" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.raineyretro.courtsidechaos" />
    </queries>

    <application
        android:name=".RaineyApplication"
        android:allowBackup="true"
        android:banner="@drawable/rainey_banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rainey">
        <activity
            android:name=".nativeemu.NativeEmulatorActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Rainey" />
        <service
            android:name=".duckstation.DuckStationOverlayService"
            android:exported="false" />
        <service
            android:name=".dreamcast.DreamcastOverlayService"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".RaineyLauncherKeyService"
            android:exported="true"
            android:label="@string/launcher_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rainey_launcher_key_service" />
        </service>
        <activity
            android:name=".HomeToggleActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.rainey.frontend.home"
            android:theme="@style/Theme.Rainey.Router" />
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.rainey.frontend.main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
